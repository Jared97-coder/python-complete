# ============================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Rellena los valores según tu configuración
# 3. NUNCA commits .env al repositorio
# 4. Agrega .env a tu .gitignore
#
# ============================================

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================
APP_NAME=MiAplicacion
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# ============================================
# BASE DE DATOS
# ============================================
# Ejemplos de DATABASE_URL:
# SQLite: sqlite:///database.db
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
# MySQL: mysql://user:password@localhost:3306/dbname
# SQL Server: mssql+pyodbc://user:password@localhost/dbname?driver=ODBC+Driver+17+for+SQL+Server

DATABASE_URL=sqlite:///database.db
DATABASE_POOL_SIZE=10
DATABASE_ECHO=False

# ============================================
# SEGURIDAD
# ============================================
# IMPORTANTE: Cambia estos valores en producción
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY=your-api-key-here

# ============================================
# CONFIGURACIÓN DE EMAIL
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_password_de_aplicacion

# ============================================
# SERVICIOS EXTERNOS
# ============================================
# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PROJECT_ID=

# ============================================
# APIs DE TERCEROS
# ============================================
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

SENDGRID_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# REDIS / CACHE
# ============================================
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=redis

# ============================================
# LOGS
# ============================================
LOG_LEVEL=INFO
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================
# SERVIDOR WEB
# ============================================
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# DESARROLLO / TESTING
# ============================================
TESTING=False
DEVELOPMENT=True
PRODUCTION=False
